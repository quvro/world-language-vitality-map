# 复制这个文件为 web/.env.local，然后填入你自己的密钥。
#
#   copy .env.example .env.local      （Windows）
#   cp   .env.example .env.local      （macOS / Linux）
#
# web/.env.local 已被 .gitignore 挡住（.env、.env.* 全部忽略），不会进仓库。
# 改完重启 `pnpm dev` 生效。
#
# ⚠️ 不要给密钥加 VITE_ 前缀。带 VITE_ 的变量会被 Vite **打进前端产物**，
#    任何人打开网页都能在 JS 里看到。这里的密钥只在服务端使用。

DEEPSEEK_API_KEY=

# 可选：换成其它 OpenAI 兼容服务
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
