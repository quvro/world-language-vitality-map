{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowJs": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  },
  // vite.config.ts 曾在这里，但检查它会报 20 个错：它用到 process / Buffer /
  // node:url / node:fs / node:path，而 @types/node 没装（装它会往工作区之外的
  // pnpm store 写，被沙箱拒绝）。为了不让 `pnpm build` 卡在第一步，
  // 这里先把配置文件排除；装上 @types/node 后可把它加回来。
  //
  // 顺带记一笔：这个项目一直用 `vite dev` 开发，而 **Vite 只转译、不做类型检查**，
  // 所以 `vue-tsc` 里积了 20 个错（含 store 的 activeView 联合类型漏了两个新视图）
  // 直到这次 review 才发现。**改完前端记得跑 `pnpm typecheck`**。
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue"]
}
